# Copy to .env and adjust as needed. docker-compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host port that the postgres container is published on (avoids clashing with a
# local postgres already listening on 5432).
POSTGRES_HOST_PORT=5433

# --- Application ---
LOG_LEVEL=INFO

# Rows per COPY batch during bulk load. Higher = fewer round trips, more memory.
ETL_BATCH_SIZE=50000

# Where the ETL looks for input CSVs (inside the container).
DATA_DIR=/app/data/sample

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Max page size the GraphQL API will return, to keep queries bounded.
API_MAX_PAGE_SIZE=200
